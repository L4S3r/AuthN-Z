# =============================================================================
# Auth N&Z Security Gateway - Environment Configuration Template (.env.example)
# =============================================================================
# Copy this file to .env and adjust variables as needed:
#     cp .env.example .env
# =============================================================================

# Server Environment & Documentation Gating
# Options: production | development | testing
ENVIRONMENT=production

# Public API Documentation (/docs, /redoc, /openapi.json)
# Set to 'true' to expose OpenAPI documentation on public domains
ENABLE_DOCS=true

# Cryptographic Token Signing Secret
# Generate a cryptographically secure 32-byte secret using:
#     openssl rand -hex 32
JWT_SECRET_KEY=replace_with_32_byte_random_hex_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# Password Hashing Engine (Dual-Engine: Argon2id + Bcrypt)
# =============================================================================
# Options: argon2id (recommended) | bcrypt
PASSWORD_HASH_ALGORITHM=argon2id
BCRYPT_WORK_FACTOR=12
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4

# =============================================================================
# FIDO2 / WebAuthn Level 3 Passkeys & Security Keys
# =============================================================================
# Defaults to hostname from FRONTEND_URL if left blank
WEBAUTHN_RP_ID=
WEBAUTHN_RP_NAME=Auth N&Z

# =============================================================================
# Distributed Policy Storage & Open Policy Agent (OPA)
# =============================================================================
OPA_ENABLED=false
OPA_URL=http://localhost:8181/v1/data/authnz/allow
OPA_TIMEOUT_SECONDS=1.0
POLICY_FILE_PATH=policies/rules.json
POLICY_CACHE_TTL_SECONDS=300

# =============================================================================
# Redis Persistence & Distributed Session Store
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REQUIRE_REDIS=false

# =============================================================================
# Social Login / OAuth2 & OpenID Connect (OIDC) Credentials
# =============================================================================
# Google OAuth 2.0 Credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth App Credentials (from GitHub Developer Settings)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# =============================================================================
# Transactional Email Notification & SMTP Configuration
# =============================================================================
# Frontend Web App URL for generating invitation & verification links
FRONTEND_URL=http://localhost:3000

# Option 1: Gmail SMTP (Free)
# 1. Enable 2-Step Verification on your Google Account
# 2. Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_char_app_password
SMTP_FROM=Auth N&Z <noreply@l4s3r.site>

# Option 2: Resend (Free 3,000 emails/mo)
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASSWORD=re_123456789
# SMTP_FROM=Auth N&Z <onboarding@resend.dev>

# =============================================================================
# Database Configuration (PostgreSQL Async Backend)
# =============================================================================
DATABASE_URL=postgresql+asyncpg://authnz_app:YourSecurePasswordHere@localhost:5432/authnz

# Individual connection parameters fallback:
# POSTGRES_USER=authnz_app
# POSTGRES_PASSWORD=YourSecurePasswordHere
# POSTGRES_DB=authnz
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20

# =============================================================================
# Production Observability (Optional)
# =============================================================================
SENTRY_DSN=
