# =============================================================================
# Auth N&Z - Local & Production Environment Configuration Template
# =============================================================================

# Deployment Environment: development | production | testing
ENVIRONMENT=development

# JWT Secret Key (Minimum 32 bytes high-entropy random string)
JWT_SECRET_KEY=replace_with_a_super_secret_high_entropy_key_minimum_32_bytes

# Access & Refresh Token Lifespans
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Password Hashing Algorithm: argon2id (recommended) | bcrypt
PASSWORD_HASH_ALGORITHM=argon2id

# PostgreSQL Async Database Connection URL
DATABASE_URL=postgresql+asyncpg://authnz_app:password123@127.0.0.1:5432/authnz

# Redis Session & Cache Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REQUIRE_REDIS=false

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:3000"]

# Open Policy Agent (OPA) Integration (Optional)
OPA_ENABLED=false
OPA_URL=http://localhost:8181/v1/data/authnz/allow

# SMTP Email Dispatch (Optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=auth@yourdomain.com
SMTP_TLS=true
