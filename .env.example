# =============================================================================
# Auth N&Z Security Gateway - Environment Configuration Template (.env.example)
# =============================================================================
# Copy this file to .env and adjust variables as needed:
#     cp .env.example .env
# =============================================================================

# Server Environment & Documentation Gating
# Options: production | development | testing
ENVIRONMENT=production

# Public API Documentation (/docs, /redoc, /openapi.json)
# Set to 'true' to expose OpenAPI documentation on auth-api.l4s3r.site
ENABLE_DOCS=true

# Cryptographic Token Signing Secret
# Generate a cryptographically secure 32-byte secret using:
#     openssl rand -hex 32
JWT_SECRET_KEY=replace_with_32_byte_random_hex_key

# Redis Persistence & Stateful Session Store
# Default local connection for Kali Linux / VPS
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# =============================================================================
# Social Login / OAuth2 & OpenID Connect (OIDC) Credentials
# =============================================================================

# Google OAuth 2.0 Credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth App Credentials (from GitHub Developer Settings)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# =============================================================================
# Transactional Email Notification & SMTP Configuration
# =============================================================================
# Frontend Web App URL for generating invitation & verification links
FRONTEND_URL=http://localhost:3000

# Option 1: Gmail SMTP (Free)
# 1. Enable 2-Step Verification on your Google Account
# 2. Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_char_app_password
SMTP_FROM=TaskTracker <your_email@gmail.com>

# Option 2: Resend (Free 3,000 emails/mo)
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASSWORD=re_123456789
# SMTP_FROM=TaskTracker <onboarding@resend.dev>

# =============================================================================
# Optional Deployment Variables
# =============================================================================
# Database file location (defaults to DATABASE.db in project root)
DB_FILE=DATABASE.db

